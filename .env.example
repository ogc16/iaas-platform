# Application environment: development (default), staging, or production.
# In production (anything other than development) the server refuses to boot
# with a placeholder or weak JWT_SECRET.
ENV=development

PORT=8080

# PostgreSQL connection string.
# For local development sslmode=disable is fine. In any deployed environment
# replace sslmode=disable with sslmode=require, or prefer sslmode=verify-full
# (with the server CA available) so the connection is encrypted and the server
# certificate is validated.
DATABASE_URL=postgres://iaas:iaas@localhost:5432/iaas?sslmode=disable

# Signing secret for JWTs. Generate a strong random value, e.g.:
#   openssl rand -hex 32
# Never run with the placeholder below outside development.
JWT_SECRET=change-me-to-a-secure-random-string
JWT_ISSUER=iaas-platform
JWT_EXPIRES_IN=86400

# Password hashing cost for bcrypt (4-15, default 12). 12 is a sensible
# production default; lower it on very constrained hardware, never below 10.
BCRYPT_COST=12

# Connection pool bounds. DB_MIN_CONNS is kept warm; DB_MAX_CONNS caps
# concurrent database connections (defaults: min 2, max 20).
DB_MAX_CONNS=20
DB_MIN_CONNS=2

# Terminate TLS in-process. Both must be set together. When unset the server
# listens on plain HTTP (e.g. behind a proxy/load balancer that handles TLS).
# Leave commented out when you do not serve TLS directly.
# TLS_CERT_FILE=/run/secrets/tls.crt
# TLS_KEY_FILE=/run/secrets/tls.key

# Compute simulation provider timings (seconds).
# How long a simulated instance takes to reach running/stopped, and how often
# the lifecycle reconciler advances transient states.
PROVISIONING_DELAY_SECONDS=5
STOP_DELAY_SECONDS=3
RECONCILE_INTERVAL_SECONDS=2

# Public base URL of the dashboard. Used to build password reset links in
# emails. Must be reachable by your users (not localhost in production).
APP_BASE_URL=http://localhost:8080

# SMTP relay used for password reset emails. When SMTP_HOST is left empty the
# server logs the reset link instead of sending an email, which is convenient
# for local development.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=postmaster@example.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=IaaS Platform <no-reply@example.com>

# How long a password reset token stays valid (hours, default 24).
PASSWORD_RESET_TTL_HOURS=24

# Comma-separated list of allowed CORS origins. In development the default
# is "*" (allow all). In production the server refuses to boot with a
# wildcard or empty list — set explicit origins, e.g.:
#   CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=*
