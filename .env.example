# Application environment: development (default), staging, or production.
# In production (anything other than development) the server refuses to boot
# with a placeholder or weak JWT_SECRET.
ENV=development

PORT=8080

# PostgreSQL connection string.
# For local development sslmode=disable is fine. In any deployed environment
# replace sslmode=disable with sslmode=require, or prefer sslmode=verify-full
# (with the server CA available) so the connection is encrypted and the server
# certificate is validated.
DATABASE_URL=postgres://iaas:iaas@localhost:5432/iaas?sslmode=disable

# Signing secret for JWTs. Generate a strong random value, e.g.:
#   openssl rand -hex 32
# Never run with the placeholder below outside development.
JWT_SECRET=change-me-to-a-secure-random-string
JWT_ISSUER=iaas-platform
JWT_EXPIRES_IN=86400

# Compute simulation provider timings (seconds).
# How long a simulated instance takes to reach running/stopped, and how often
# the lifecycle reconciler advances transient states.
PROVISIONING_DELAY_SECONDS=5
STOP_DELAY_SECONDS=3
RECONCILE_INTERVAL_SECONDS=2
